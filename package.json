{
  "name": "peeparr",
  "description": "Self-hosted hub for an adult video library alongside Stash and Whisparr: discover scenes from StashDB, FansDB or ThePornDB, request them, follow the downloads and watch.",
  "keywords": [
    "stash",
    "stashapp",
    "whisparr",
    "stashdb",
    "fansdb",
    "theporndb",
    "self-hosted",
    "homelab",
    "media-server",
    "media-requests",
    "overseerr-alternative",
    "jellyseerr-alternative",
    "arr",
    "docker",
    "proxmox",
    "pwa",
    "angular",
    "nestjs"
  ],
  "homepage": "https://github.com/John-Butler3/Peeparr#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/John-Butler3/Peeparr.git"
  },
  "bugs": {
    "url": "https://github.com/John-Butler3/Peeparr/issues"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "web": "pnpm --filter ./apps/sp-web start",
    "backend": "pnpm --filter ./apps/sp-api start:dev",
    "dev:db": "docker compose -f infrastructure/compose/docker-compose.yml up -d postgres",
    "db:repair-runtime-health-migration": "node scripts/repair-runtime-health-migration.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "^3.23.1",
      "deepmerge-ts": "^8.0.0",
      "@istanbuljs/load-nyc-config>js-yaml": "^4.1.0"
    }
  }
}

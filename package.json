{
  "name": "peeparr",
  "description": "Self-hosted hub for an adult video library alongside Stash and Whisparr: discover scenes from StashDB, FansDB or ThePornDB, request them, follow the downloads and watch.",
  "keywords": [
    "stash",
    "stashapp",
    "whisparr",
    "stashdb",
    "fansdb",
    "theporndb",
    "self-hosted",
    "homelab",
    "media-server",
    "media-requests",
    "overseerr-alternative",
    "jellyseerr-alternative",
    "arr",
    "docker",
    "proxmox",
    "pwa",
    "angular",
    "nestjs"
  ],
  "homepage": "https://github.com/John-Butler3/Peeparr#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/John-Butler3/Peeparr.git"
  },
  "bugs": {
    "url": "https://github.com/John-Butler3/Peeparr/issues"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "web": "pnpm --filter ./apps/sp-web start",
    "backend": "pnpm --filter ./apps/sp-api start:dev",
    "dev:db": "docker compose -f infrastructure/compose/docker-compose.yml up -d postgres",
    "db:repair-runtime-health-migration": "node scripts/repair-runtime-health-migration.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "^3.23.1",
      "deepmerge-ts": "^8.0.0",
      "@istanbuljs/load-nyc-config>js-yaml": "^4.1.0",
      "hono@<4.13.16": "^4.13.16",
      "@hono/node-server@<2.1.6": "^2.1.6",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "undici@<6.29.1": "^6.29.1",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "fast-uri@<3.1.9": "^3.1.9",
      "multer@<2.5.0": "^2.5.0",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
